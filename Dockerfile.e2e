FROM golang:1.26-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/e2e-mock ./cmd/e2e-mock \
    && CGO_ENABLED=0 go build -trimpath -o /out/e2e-runner ./cmd/e2e-runner

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/e2e-mock /usr/local/bin/e2e-mock
COPY --from=builder /out/e2e-runner /usr/local/bin/e2e-runner
ENTRYPOINT ["e2e-runner"]
