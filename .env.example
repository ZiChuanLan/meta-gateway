# Meta Gateway Configuration
HTTP_ADDR=:4100
DATA_DIR=./data
BACKUP_DIR=./data/backups

# Required secrets. Use independent random values; never commit a populated .env.
ADMIN_TOKEN=change-me-to-a-random-string
# Optional comma-separated additional admin tokens for rotation (merged with ADMIN_TOKEN).
ADMIN_TOKENS=
MASTER_KEY=change-me-to-a-32-char-min-key-here
METRICS_TOKEN=change-me-to-an-independent-random-string

# SQLite connection-pool ceiling (WAL allows concurrent readers alongside a
# single writer). 1 restores the old fully serialized behavior.
SQLITE_MAX_OPEN_CONNS=4

# When false, Admin exchange export with include_secrets is rejected.
EXCHANGE_ALLOW_SECRET_EXPORT=true

# Private/special upstreams are denied unless their exact host or address range
# is listed. Environment HTTP proxy variables are intentionally ignored.
OUTBOUND_ALLOW_HOSTS=
OUTBOUND_ALLOW_CIDRS=
OUTBOUND_CONNECT_TIMEOUT_SECONDS=10
OUTBOUND_TLS_TIMEOUT_SECONDS=10
OUTBOUND_HEADER_TIMEOUT_SECONDS=60
# Outbound connection reuse: multi-channel gateways fan out to shared upstream
# hosts, so raise the idle-pool ceilings above the Go default of 2 per host.
OUTBOUND_MAX_IDLE_CONNS=512
OUTBOUND_MAX_IDLE_CONNS_PER_HOST=64

# Forwarded client addresses and token-free metrics scraping are trusted only
# from explicitly configured networks.
TRUSTED_PROXY_CIDRS=
TRUSTED_SCRAPER_CIDRS=

# A rate of 0 disables only that limiter.
RELAY_RATE_PER_MINUTE=600
RELAY_RATE_BURST=100
# Optional per-model limiter on top of the global relay limiter (0 = off).
RELAY_MODEL_RATE_PER_MINUTE=0
RELAY_MODEL_RATE_BURST=0
ADMIN_RATE_PER_MINUTE=300
ADMIN_RATE_BURST=50

MAX_HEADER_BYTES=1048576
MAX_ADMIN_BODY_BYTES=2097152
SERVER_READ_HEADER_TIMEOUT_SECONDS=10
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=120
SERVER_SHUTDOWN_TIMEOUT_SECONDS=15
READINESS_TIMEOUT_SECONDS=2

AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_ROWS=100000

RETRY_TIMES=2
# Allow a failed request to move to another eligible channel. Disable to try
# only the first selected channel; same-channel API-key rotation is unchanged.
CROSS_CHANNEL_FAILOVER_ENABLED=true
COOLDOWN_SECONDS=30
FAULT_PROTECTION_ENABLED=true
# Progressive cooldown escalates the wait per consecutive failure:
# COOLDOWN_SECONDS is level 1, then LEVEL2/3/4 apply on repeated failures.
# Parked members are periodically re-probed and auto-recovered.
RECOVERY_PROBE_ENABLED=true
RECOVERY_PROBE_INTERVAL_SECONDS=600

# Failure thresholds (each layer independent; 0 disables that layer):
# Consecutive relay failures before a channel is auto_disabled (0 = never).
CHANNEL_AUTO_DISABLE_THRESHOLD=5
# Per-channel in-channel retry rounds (0-5) and same-channel key rotation.
CHANNEL_RETRY_TIMES=1
KEY_POOL_ROTATION=true

# Adaptive routing signals feeding the selector score (latency, error
# history, in-flight load). ROUTING_CONCURRENCY_LIMIT caps the per-model
# in-flight ceiling used by the concurrency signal.
ROUTING_LATENCY_AWARE=true
ROUTING_ERROR_AWARE=true
ROUTING_CONCURRENCY_AWARE=true
ROUTING_CONCURRENCY_LIMIT=64
# Gray release: a stable_first channel takes ~1/DENOMINATOR of traffic until
# it accumulates PROMOTE_REQUESTS successes, then joins normal routing.
STABLE_FIRST_ENABLED=false
STABLE_FIRST_DENOMINATOR=25
STABLE_FIRST_PROMOTE_REQUESTS=100

# Sticky session routing (hot-swappable from Admin → Runtime settings).
STICKY_ENABLED=false
STICKY_TTL_MINUTES=30

# Outbound notifications (generic webhook sink; also used by alerts below).
# WEBHOOK_THROTTLE_SECONDS collapses identical repeated notifications.
WEBHOOK_URL=
WEBHOOK_THROTTLE_SECONDS=300
# Alert rules sweep + daily digest cadence; 0 disables that tick.
# ALERT_CONFIG_JSON: matrix of bark/serverchan/telegram/SMTP channels.
ALERT_CONFIG_JSON=
ALERT_SWEEP_INTERVAL_SECONDS=0
ALERT_DAILY_SUMMARY_INTERVAL_SECONDS=0

# Scheduled credential check-in is opt-in and uses a standard five-field cron.
# Default check-in path is Bearer access_token + platform user id headers
# (auto-filled from GET /api/user/self when meta lacks platform_user_id).
# Cookie / browser check-in is intentionally not supported yet.
CHECKIN_ENABLED=false
CHECKIN_CRON=0 8 * * *
# IANA timezone for CHECKIN_CRON (empty = process local time; containers
# usually default to UTC, e.g. Asia/Shanghai).
CHECKIN_TZ=

# Periodic channel health sweep: jittered probes grade each enabled channel
# operational/degraded/error and alert on state transitions (admin /health).
# Enabled by default; every successful probe also refreshes the connectivity
# (ping) verdict, so page visits no longer batch-ping channels.
HEALTH_SWEEP_ENABLED=true
HEALTH_SWEEP_INTERVAL_SECONDS=300
HEALTH_SWEEP_JITTER_SECONDS=30
HEALTH_SWEEP_DEGRADED_MS=2000
HEALTH_SWEEP_CONCURRENCY=4
HEALTH_SWEEP_TIMEOUT_SECONDS=15

# Channel health probe history retention (days). 0 would disable pruning;
# the pruner runs on the daily maintenance tick.
HEALTH_HISTORY_RETENTION_DAYS=90
# Balance and routing decision history retention. Set either to 0 to disable
# that pruner (the daily maintenance tick remains enabled).
BALANCE_HISTORY_RETENTION_DAYS=90
DECISION_SNAPSHOT_RETENTION_DAYS=7

# Maximum verified backup snapshots and history rows to retain. 0 disables
# automatic pruning.
BACKUP_RETENTION_COUNT=30

# Official plugin packages are installed under DATA_DIR/plugins.
PLUGINS_DIR=
# Optional remote catalog JSON URL. Merged with the embedded official catalog.
# Accepts either [{"id":...}] or {"plugins":[...]}. Failures fall back to embedded.
PLUGIN_CATALOG_URL=
# Comma-separated extra market source URLs merged into the plugin market page.
PLUGIN_MARKET_URLS=

# Read-only WebDAV pull of All API Hub backups (GET only; no upload/merge).
# Prefer configuring in Admin → System → Exchange (saved encrypted in SQLite).
# Env values are bootstrap fallback when no Admin settings are saved yet.
# Directory URLs expand to all-api-hub-backup/all-api-hub-1-0.json.
# Encrypted envelopes need a backup decrypt password (Admin form or env).
WEBDAV_SYNC_ENABLED=false
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_BACKUP_PASSWORD=
WEBDAV_CRON=0 */6 * * *
WEBDAV_MAX_BYTES=10485760
